{
  "format": "json",
  "data": {
    "env": {
      "ANTHROPIC_BASE_URL": "{active_endpoint}",
      "ANTHROPIC_MODEL": "{single_model_tier}",
      "CLAUDE_CODE_DISABLE_THINKING": "1",
      "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1"
    }
  },
  "files": {
    "launch.json": {
      "format": "json",
      "data": {
        "command": [
          "claude",
          "--settings",
          "{workspace}/.claude/settings.local.json"
        ],
        "env": {
          "CLAUDE_CONFIG_DIR": "{workspace}/.claude-home"
        },
        "requires": ".claude/settings.local.json"
      }
    }
  },
  "copy_home": {
    "env": "CLAUDE_CONFIG_DIR",
    "default": "~/.claude",
    "to": ".claude-home",
    "skip": [
      "logs",
      "log",
      "*.log",
      "*.lock",
      "tmp",
      ".tmp",
      ".tmp.*",
      "projects",
      "jobs",
      "file-history",
      "backups",
      "session-env",
      "shell-snapshots",
      "paste-cache",
      "telemetry",
      "history.jsonl",
      "stats-cache.json",
      "*.zip"
    ]
  }
}

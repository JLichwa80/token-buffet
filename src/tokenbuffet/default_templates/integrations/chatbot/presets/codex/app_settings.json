{
  "format": "text",
  "content": "model = \"{single_model_tier}\"\nmodel_provider = \"local_bridge\"\n\n[model_providers.local_bridge]\nname = \"Local Bridge\"\nbase_url = \"{active_endpoint}\"\nwire_api = \"responses\"\nrequires_openai_auth = false\nsupports_websockets = false\n",
  "files": {
    "launch.json": {
      "format": "json",
      "data": {
        "command": [
          "codex"
        ],
        "env": {
          "CODEX_HOME": "{workspace}/.codex"
        },
        "requires": ".codex/config.toml"
      }
    },
    ".codex/.gitignore": {
      "format": "text",
      "content": "*\n!.gitignore\n!config.toml\n"
    }
  },
  "copy_home": {
    "env": "CODEX_HOME",
    "default": "~/.codex",
    "to": ".codex",
    "skip": [
      "logs",
      "log",
      "*.log",
      "*.lock",
      "tmp",
      ".tmp"
    ]
  }
}

{
  "format": "text",
  "content": "[model.local-bridge]\nmodel = \"{single_model_tier}\"\nbase_url = \"{active_endpoint}\"\nname = \"Local Bridge\"\napi_backend = \"chat_completions\"\n\n[models]\ndefault = \"local-bridge\"\n",
  "files": {
    "launch.json": {
      "format": "json",
      "data": {
        "command": [
          "grok"
        ],
        "env": {
          "GROK_HOME": "{workspace}/.grok"
        },
        "requires": ".grok/config.toml"
      }
    },
    ".grok/.gitignore": {
      "format": "text",
      "content": "*\n!.gitignore\n!config.toml\n"
    }
  },
  "copy_home": {
    "env": "GROK_HOME",
    "default": "~/.grok",
    "to": ".grok",
    "skip": [
      "logs",
      "log",
      "*.log",
      "*.lock",
      "tmp",
      ".tmp"
    ]
  }
}
